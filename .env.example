# =============================================================================
# CONFIGURACIÓN DEL OPERADOR DE LA APP (vos). Se carga UNA sola vez.
# Los comercios nunca ven estos datos: ellos conectan su cuenta con un botón.
# En producción todas son obligatorias salvo las marcadas como opcionales.
# =============================================================================

# APP_URL: URL pública de la app, sin barra final. Con dominio propio, cargala siempre.
# En Vercel se toma sola si no la cargás; AI Studio la inyecta en Cloud Run.
APP_URL="https://tu-app.run.app"

# APP_SECRET: clave propia, 32 caracteres o más. Protege sesiones y tokens guardados.
# Si la cambiás, se cierran las sesiones y todos los comercios deben reconectar MP.
APP_SECRET=""

# MERCADOPAGO_CLIENT_ID y CLIENT_SECRET: de TU aplicación en Mercado Pago Developers.
# Es una sola aplicación para todos los comercios.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# MERCADOPAGO_WEBHOOK_SECRET: "Firma secreta" de Configuración de Webhooks de esa aplicación.
MERCADOPAGO_WEBHOOK_SECRET=""

# REGISTRATION_CODE: código que le das a quien te compra para crear su cuenta.
# Evita que cualquiera se registre gratis.
REGISTRATION_CODE=""

# FIREBASE_SERVICE_ACCOUNT: JSON de la cuenta de servicio de Firebase (o el mismo JSON en Base64).
FIREBASE_SERVICE_ACCOUNT=""

# Opcional: base de Firestore con nombre propio. Vacío usa la predeterminada.
FIRESTORE_DATABASE_ID=""

# Opcional: "true" activa pagos simulados en producción. No lo uses con clientes reales.
ALLOW_SIMULATION=""

# GEMINI_API_KEY: la inyecta AI Studio. Esta app no la usa.
GEMINI_API_KEY=""
